# Reference only — do NOT rename this to .yml yet.
#
# The recommended way to get this file for real is to run, from inside the
# repo, in your local Claude Code CLI:
#
#     /install-github-app
#
# That command installs the Claude GitHub App, lets you pick an auth method
# (API key or your Pro/Max OAuth token), stores the credential as a repo
# secret, and opens a PR with a working .github/workflows/claude.yml.
#
# This file is kept here as a fallback / reference in case you want to see
# what that generated workflow looks like, or wire it up by hand instead.

name: Claude Code

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

jobs:
  claude:
    if: contains(github.event.comment.body, '@claude')
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
      issues: write
      id-token: write
      actions: read
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
